# Backend environment (native run). Copy to backend/.env and replace every change-me. Never commit the real file.
NODE_ENV=development
PORT=5000
DATABASE_URL=postgres://postgres:change-me@localhost:5432/ai_interview_coach
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=change-me          # must equal ai-service/.env
# How long to wait for speech transcription / video analysis before giving up (ms). First voice answer after a cold start can be slow.
AI_SERVICE_SPEECH_TIMEOUT_MS=120000
CODE_EXECUTOR_URL=http://localhost:9000
CODE_EXECUTOR_API_KEY=change-me       # must equal code-executor/.env
# Resume files are stored OUTSIDE the web root. Use an absolute path you can back up.
RESUME_STORAGE_DIR=./uploads/resumes
# Optional tuning (defaults shown)
# LOGIN_MAX_ATTEMPTS=10
# REGISTER_MAX_PER_HOUR=20
# MAX_ASSESSMENT_ATTEMPTS=5
# Hiring-team invitation links expire after this many days (default 7). No e-mail is sent; the owner copies the link.
# INVITE_TTL_DAYS=7
# Export / account-deletion attempts allowed per 15 minutes per IP (default 10).
# ACCOUNT_ACTION_MAX_PER_15MIN=10
# General API limit per IP per 15 minutes (default 300). Raise it (e.g. 3000) while you run the multi-account end-to-end test from one machine.
# API_MAX_PER_15MIN=300
# Run Code requests per user per minute (default 20).
# RUN_CODE_MAX_PER_MINUTE=20
# MAX_RESUME_BYTES=5242880
# MAX_RESUMES_PER_USER=5
# MAX_AUDIO_BYTES=10485760
# MAX_VIDEO_BYTES=26214400
# PDF_PARSE_TIMEOUT_MS=10000

# --- Local AI (Ollama) features: follow-up questions, STAR coaching, coding coach, interview report ---
# The model itself is configured in ai-service/.env. These two only tune the backend side.
AI_SERVICE_LLM_TIMEOUT_MS=150000   # how long the backend waits for one local-model answer
FOLLOWUP_MAX_TURNS=2               # follow-ups allowed per question (1-3)
LLM_MAX_PER_MINUTE=12              # per user, for model-calling requests

# --- Interview scoring weights (practice interviews). Optional; defaults 70/12/10/8. Numbers are scaled to 100%.
# Limits: content >= 50%, camera <= 15%. Invalid values are ignored with a warning. Coding results are never affected.
# SCORE_WEIGHT_CONTENT=70
# SCORE_WEIGHT_SPEECH=12
# SCORE_WEIGHT_TYPING=10
# SCORE_WEIGHT_CAMERA=8

# --- Face behaviour monitoring (optional, practice only, consent-based). All values below are the defaults. ---
# FACE_MONITOR_RETENTION_DAYS=30     # sessions and events are deleted after this many days
# AI_SERVICE_FACE_TIMEOUT_MS=8000    # how long one frame may take in the AI service
# FACE_FRAME_MAX_PER_MINUTE=60       # per user (FACE_REFERENCE_MAX_PER_MINUTE=10 for start photos)
# FACE_ABSENCE_SEC=5                 # no face for this long => observation (warning at FACE_ABSENCE_WARN_SEC=15)
# FACE_MULTI_SEC=3                   # more than one face for this long => observation
# FACE_HEAD_YAW_DEG=30  FACE_HEAD_PITCH_DEG=25  FACE_HEAD_SEC=4
# FACE_GAZE_DEVIATION=0.5  FACE_GAZE_SEC=4

# Snapshots of the answer video shown next to each camera measurement (small JPEGs kept with the answer, practice interviews only).
# off = none are produced / stored.
ANSWER_SNAPSHOTS=on
