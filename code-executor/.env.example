# Code executor environment. Copy to code-executor/.env. Never commit the real file.
CODE_EXECUTOR_API_KEY=change-me       # must equal backend/.env
PORT=9000
ALLOWED_ORIGINS=http://localhost:5000
# Per-submission container limits (defaults shown). Do not raise them casually: they are part of the sandbox.
# EXECUTION_TIMEOUT_MS=2000
# MEMORY_LIMIT_MB=256
# CPU_LIMIT_CORES=0.5
# PIDS_LIMIT=64
# MAX_TEST_CASES=20
