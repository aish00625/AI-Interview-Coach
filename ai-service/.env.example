# AI service environment. Copy to ai-service/.env (the Windows setup script does this and fills the key for you).
# Never commit the real file.
AI_SERVICE_API_KEY=change-me          # must equal AI_SERVICE_API_KEY in backend/.env
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5000

# --- Speech-to-text (faster-whisper, local) -------------------------------------------------------------------------
# Model size: tiny < base < small < medium. Bigger = fewer transcription mistakes, slower, bigger download
# (small is about 460 MB, once). 'small' is the default because tiny/base make noticeably more mistakes on accents and
# technical words. If your PC is slow, use base. Not an accuracy guarantee at any size.
SPEECH_MODEL_SIZE=small
SPEECH_DEVICE=cpu
SPEECH_COMPUTE_TYPE=int8
# Language hint. 'en' stops accented English being mis-detected as another language. Empty = auto-detect.
SPEECH_LANGUAGE=en
# Load the model when the service starts instead of on the first voice answer (recommended).
SPEECH_PRELOAD=true
# Silence removal before decoding (prevents invented text from silence/noise).
SPEECH_VAD_FILTER=true
# After the model has been downloaded once you may set this to true to forbid any network access.
SPEECH_LOCAL_ONLY=false
# SPEECH_MODEL_DIR=
# MIN_AUDIO_SECONDS=1
# MAX_AUDIO_SECONDS=300

# --- Webcam analysis (optional) -------------------------------------------------------------------------------------
# Head-direction/gaze need MediaPipe's small model file. Fetch it with:  python -m app.diagnostics --download-vision-model
# FACE_LANDMARKER_MODEL_PATH=
# MAX_VIDEO_DURATION_SECONDS=180

# --- Local language model through Ollama (free, runs on this computer; optional) ---
# Install Ollama, then:  ollama pull qwen3:4b      (about 2.5 GB; use qwen3:1.7b or llama3.2:3b on 8 GB RAM or less)
LLM_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434     # must be this computer unless LLM_ALLOW_REMOTE=true
LLM_MODEL=qwen3:4b
LLM_TIMEOUT_SECONDS=120
LLM_MAX_OUTPUT_TOKENS=700
LLM_CONTEXT_TOKENS=4096
LLM_ALLOW_REMOTE=false

# --- Face behaviour monitoring (optional) ---
# Face presence, count and image quality need only OpenCV. Head pose and gaze also need the landmark model above.
# The same-person check additionally needs OpenCV's SFace ONNX model, which is NOT downloaded for you: get it yourself from the
# OpenCV model zoo (face_recognition_sface_2021dec.onnx), check its hash, and point to it here.
# FACE_RECOGNITION_MODEL_PATH=
# FACE_IDENTITY_SIMILARITY_THRESHOLD=0.363
# FACE_MAX_CONCURRENT=2

# Snapshots of the answer video shown next to each camera measurement (small JPEGs kept with the answer, practice interviews only).
# off = none are produced / stored.
ANSWER_SNAPSHOTS=on
