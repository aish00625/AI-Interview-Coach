# Root .env for docker-compose.yml. Copy to .env and replace EVERY change-me value. Never commit the real file.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ai_interview_coach
# Long random strings, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
AI_SERVICE_API_KEY=change-me
CODE_EXECUTOR_API_KEY=change-me
# Only used if you run the executor on the host instead of the compose 'executor' profile.
CODE_EXECUTOR_URL=http://host.docker.internal:9000

# Optional speech tuning for the compose 'ai-service' (defaults shown). Bigger model = fewer transcription mistakes, slower, larger one-time download.
# SPEECH_MODEL_SIZE=small
# SPEECH_LANGUAGE=en
# How long the backend waits for a voice answer to be transcribed (milliseconds). The first answer after a cold start can be slow.
# AI_SERVICE_SPEECH_TIMEOUT_MS=120000
